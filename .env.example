# ============================================================
# ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ LMS.
# Скопируйте в .env.local и заполните значениями из проекта
# Supabase (Settings -> API). NEVER коммитить реальные ключи!
# ============================================================

# Публичный URL проекта Supabase (напр. https://xyz.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Публичный (anon) ключ — используется браузером; защищён RLS-политиками
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Сервисный ключ — ТОЛЬКО для сервера (admin-обход RLS при миграциях/сиде).
# В клиентский бандл не попадает (нет префикса NEXT_PUBLIC).
SUPABASE_SERVICE_ROLE_KEY=

# Базовый адрес приложения (для callback-URL авторизации, ссылок в письмах)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sentry DSN для мониторинга ошибок (неделя 4 / эксплуатация)
NEXT_PUBLIC_SENTRY_DSN=
